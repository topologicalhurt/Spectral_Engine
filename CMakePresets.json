{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Debug (Repo Root)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPECTRAL_PRODUCTION_BUILD": "OFF"
      }
    },
    {
      "name": "production",
      "displayName": "Production Release (Repo Root)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPECTRAL_PRODUCTION_BUILD": "ON"
      }
    },
    {
      "name": "release-fast",
      "displayName": "Release Fast (Repo Root)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPECTRAL_PRODUCTION_BUILD": "OFF"
      }
    },
    {
      "name": "pgo-gen",
      "displayName": "PGO Generate (Release Fast)",
      "inherits": "release-fast",
      "cacheVariables": {
        "SPECTRAL_PGO": "gen"
      }
    },
    {
      "name": "pgo-use",
      "displayName": "PGO Use (Release Fast)",
      "inherits": "release-fast",
      "cacheVariables": {
        "SPECTRAL_PGO": "use"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Repo Root)",
      "inherits": "default"
    },
    {
      "name": "simulate-daisy",
      "displayName": "Simulation Daisy Profile",
      "inherits": "default",
      "cacheVariables": {
        "SPECTRAL_SIMULATION_BOARD": "daisy"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "default",
      "targets": ["desktop"]
    },
    {
      "name": "desktop-production",
      "configurePreset": "production",
      "targets": ["desktop"]
    },
    {
      "name": "desktop-release-fast",
      "configurePreset": "release-fast",
      "targets": ["desktop"]
    },
    {
      "name": "desktop-pgo-gen",
      "configurePreset": "pgo-gen",
      "targets": ["desktop"]
    },
    {
      "name": "desktop-pgo-use",
      "configurePreset": "pgo-use",
      "targets": ["desktop"]
    },
    {
      "name": "pgo-collect",
      "configurePreset": "pgo-gen",
      "targets": ["pgo_collect"]
    },
    {
      "name": "pgo-merge",
      "configurePreset": "pgo-gen",
      "targets": ["pgo_merge"]
    },
    {
      "name": "simulate",
      "configurePreset": "default",
      "targets": ["simulate"]
    },
    {
      "name": "simulate-production",
      "configurePreset": "production",
      "targets": ["simulate"]
    },
    {
      "name": "simulate-daisy",
      "configurePreset": "simulate-daisy",
      "targets": ["simulate_daisy"]
    },
    {
      "name": "embedded-arm",
      "configurePreset": "default",
      "targets": ["embedded_arm"]
    },
    {
      "name": "embedded-arm-float",
      "configurePreset": "default",
      "targets": ["embedded_arm_float"]
    },
    {
      "name": "embedded-arm-restricted",
      "configurePreset": "default",
      "targets": ["embedded_arm_restricted"]
    },
    {
      "name": "cuda",
      "configurePreset": "default",
      "targets": ["cuda"]
    },
    {
      "name": "daisy",
      "configurePreset": "default",
      "targets": ["daisy"]
    },
    {
      "name": "daisy-example",
      "configurePreset": "default",
      "targets": ["daisy_example"]
    },
    {
      "name": "convert-segments",
      "configurePreset": "default",
      "targets": ["convert_segments"]
    },
    {
      "name": "log-check",
      "configurePreset": "default",
      "targets": ["log_check"]
    }
  ]
}
